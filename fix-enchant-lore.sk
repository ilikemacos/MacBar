# fix-enchant-lore.sk
# Skript (https://skriptlang.org) for Minecraft 1.21.4 / Paper-Spigot
# Requires: Skript 2.9+ (or latest release supporting 1.21.4) — vanilla Skript only, no addons.
#
# Vanilla only has translated text for enchantment levels 1-10 (I-X).
# Any enchantment above level 10 has no translation, so the client shows
# the raw, untranslated key instead — e.g. "enchantment.level.45".
#
# This hides the native item tooltip on any item with an enchantment
# above level 10, and replaces it with custom lore lines that read
# "Enchant Level <number>" instead of the broken key.
#
# Since there's no single event that covers every way an item's
# enchantments can change (anvils, commands, other plugins, etc.), this
# rescans every online player's inventory and equipment every 3 seconds
# and fixes anything that needs it. The fix is safe to reapply, so
# rescanning doesn't cause duplicate lore lines.

function fixEnchantLore(itm: item) :: item:
	if enchantments of {_itm} is not set:
		return {_itm}

	set {_needs-fix} to false
	loop enchantments of {_itm}:
		if (level of loop-value of {_itm}) > 10:
			set {_needs-fix} to true

	if {_needs-fix} is true:
		hide {_itm}'s additional tooltip
		delete {_lore::*}
		loop enchantments of {_itm}:
			add colored "&7Enchant Level %level of loop-value of {_itm}%" to {_lore::*}
		set the lore of {_itm} to {_lore::*}

	return {_itm}

every 3 seconds:
	loop all players:
		set {_p} to loop-player

		loop 36 times:
			set {_n} to loop-number - 1
			set {_item} to slot {_n} of {_p}'s inventory
			if {_item} is set:
				set slot {_n} of {_p}'s inventory to fixEnchantLore({_item})

		set {_p}'s tool to fixEnchantLore({_p}'s tool)
		set {_p}'s off hand slot to fixEnchantLore({_p}'s off hand slot)
		set {_p}'s helmet to fixEnchantLore({_p}'s helmet)
		set {_p}'s chestplate to fixEnchantLore({_p}'s chestplate)
		set {_p}'s leggings to fixEnchantLore({_p}'s leggings)
		set {_p}'s boots to fixEnchantLore({_p}'s boots)
