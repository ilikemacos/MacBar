#!/usr/bin/env python3
"""rNitro terminal monitor — btop-style live system stats in the shell.

Usage:
  rnitro                 Launch interactive TUI
  rnitro --help          Show help
  rnitro --once          Print one JSON snapshot (for scripts)
  rnitro lab status      Print Lab status JSON written by the macOS beta app

Install:
  ./cli/install-cli.sh
  # or: ln -sf "$(pwd)/cli/rnitro" ~/bin/rnitro
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

CLI_DIR = Path(__file__).resolve().parent
if str(CLI_DIR) not in sys.path:
    sys.path.insert(0, str(CLI_DIR))

from monitor import MetricsEngine  # noqa: E402
from tui import run_tui  # noqa: E402

LAB_STATUS_PATHS = [
    Path.home() / "Library/Application Support/rNitro/lab-status.json",
    Path.home() / "Library/Application Support/com.rnitro.cpumonitor/lab-status.json",
]


def snapshot_to_dict(snap) -> dict:
    return {
        "hostname": snap.hostname,
        "uptime_s": snap.uptime_s,
        "load": snap.load,
        "cpu_percent": snap.cpu_percent,
        "core_count": snap.core_count,
        "mem_used_gb": snap.mem_used_gb,
        "mem_total_gb": snap.mem_total_gb,
        "mem_percent": snap.mem_percent,
        "disk_percent": snap.disk_percent,
        "net_down_mbps": snap.net_down_mbps,
        "net_up_mbps": snap.net_up_mbps,
        "battery_pct": snap.battery_pct,
        "top_cpu": [
            {"pid": p.pid, "name": p.name, "cpu": p.cpu, "mem_mb": p.mem_mb}
            for p in snap.top_cpu
        ],
        "top_mem": [
            {"pid": p.pid, "name": p.name, "cpu": p.cpu, "mem_mb": p.mem_mb}
            for p in snap.top_mem
        ],
    }


def lab_status_path() -> Path | None:
    for p in LAB_STATUS_PATHS:
        if p.is_file():
            return p
    return None


def cmd_lab_status() -> int:
    path = lab_status_path()
    if path is None:
        print(
            json.dumps(
                {
                    "error": "lab_status_missing",
                    "message": (
                        "No lab-status.json yet. Run rNitro macOS beta (Lab tab) once "
                        "so it writes ~/Library/Application Support/rNitro/lab-status.json"
                    ),
                    "looked_in": [str(p) for p in LAB_STATUS_PATHS],
                },
                indent=2,
            ),
            file=sys.stdout,
        )
        return 2
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        print(
            json.dumps({"error": "lab_status_unreadable", "path": str(path), "detail": str(exc)}, indent=2),
            file=sys.stderr,
        )
        return 1
    data["_path"] = str(path)
    print(json.dumps(data, indent=2))
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)

    # Subcommand: rnitro lab status
    if argv and argv[0] == "lab":
        if len(argv) >= 2 and argv[1] in ("status", "stat", "json"):
            return cmd_lab_status()
        print("Usage: rnitro lab status", file=sys.stderr)
        print("Reads Lab JSON from the macOS beta app (Application Support).", file=sys.stderr)
        return 2

    parser = argparse.ArgumentParser(
        prog="rnitro",
        description="rNitro terminal system monitor (btop-style TUI)",
    )
    parser.add_argument("--once", action="store_true", help="Print one JSON snapshot and exit")
    parser.add_argument(
        "--interval", type=float, default=1.0, help="Poll interval seconds (default: 1.0)"
    )
    args = parser.parse_args(argv)

    engine = MetricsEngine(poll_interval=args.interval)
    engine.refresh()

    if args.once:
        print(json.dumps(snapshot_to_dict(engine.snapshot), indent=2))
        return 0

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("rNitro TUI requires an interactive terminal.", file=sys.stderr)
        print("Try: rnitro --once  for JSON output.", file=sys.stderr)
        print("Or:  rnitro lab status  for Lab status from the macOS app.", file=sys.stderr)
        return 1

    return run_tui(engine)


if __name__ == "__main__":
    raise SystemExit(main())
