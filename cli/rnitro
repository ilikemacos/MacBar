#!/usr/bin/env python3
"""rNitro terminal monitor — btop-style live system stats in the shell.

Usage:
  rnitro          Launch interactive TUI
  rnitro --help   Show help
  rnitro --once   Print one JSON snapshot (for scripts)

Install:
  ./cli/install-cli.sh
  # or: ln -sf "$(pwd)/cli/rnitro" ~/bin/rnitro
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

CLI_DIR = Path(__file__).resolve().parent
if str(CLI_DIR) not in sys.path:
    sys.path.insert(0, str(CLI_DIR))

from monitor import MetricsEngine  # noqa: E402
from tui import run_tui  # noqa: E402


def snapshot_to_dict(snap) -> dict:
    return {
        "hostname": snap.hostname,
        "uptime_s": snap.uptime_s,
        "load": snap.load,
        "cpu_percent": snap.cpu_percent,
        "core_count": snap.core_count,
        "mem_used_gb": snap.mem_used_gb,
        "mem_total_gb": snap.mem_total_gb,
        "mem_percent": snap.mem_percent,
        "disk_percent": snap.disk_percent,
        "net_down_mbps": snap.net_down_mbps,
        "net_up_mbps": snap.net_up_mbps,
        "battery_pct": snap.battery_pct,
        "top_cpu": [{"pid": p.pid, "name": p.name, "cpu": p.cpu, "mem_mb": p.mem_mb} for p in snap.top_cpu],
        "top_mem": [{"pid": p.pid, "name": p.name, "cpu": p.cpu, "mem_mb": p.mem_mb} for p in snap.top_mem],
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="rnitro",
        description="rNitro terminal system monitor (btop-style TUI)",
    )
    parser.add_argument("--once", action="store_true", help="Print one JSON snapshot and exit")
    parser.add_argument("--interval", type=float, default=1.0, help="Poll interval seconds (default: 1.0)")
    args = parser.parse_args(argv)

    engine = MetricsEngine(poll_interval=args.interval)
    engine.refresh()

    if args.once:
        print(json.dumps(snapshot_to_dict(engine.snapshot), indent=2))
        return 0

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("rNitro TUI requires an interactive terminal.", file=sys.stderr)
        print("Try: rnitro --once  for JSON output.", file=sys.stderr)
        return 1

    return run_tui(engine)


if __name__ == "__main__":
    raise SystemExit(main())