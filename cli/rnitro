#!/usr/bin/env python3
"""rNitro CLI — terminal stats and app control for macOS."""
from __future__ import annotations

import argparse
import json
import os
import plistlib
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

APP_CANDIDATES = (
    Path("/Applications/rNitro.app"),
    Path.home() / "Applications/rNitro.app",
)


def find_app() -> Path | None:
    for path in APP_CANDIDATES:
        if path.is_dir():
            return path
    return None


def app_executable(app: Path) -> Path:
    return app / "Contents/MacOS/rNitro"


def read_version(app: Path | None) -> str:
    if app is None:
        return "not installed"
    plist = app / "Contents/Info.plist"
    if not plist.is_file():
        return "unknown"
    with plist.open("rb") as fh:
        data = plistlib.load(fh)
    return str(data.get("CFBundleShortVersionString") or data.get("CFBundleVersion") or "unknown")


def run(cmd: list[str], *, timeout: float = 8.0) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def cpu_usage_percent() -> float | None:
    proc = run(["top", "-l", "2", "-n", "0", "-s", "0"])
    if proc.returncode != 0:
        return None
    matches = re.findall(r"CPU usage:\s+([\d.]+)% user", proc.stdout)
    if not matches:
        return None
    try:
        return float(matches[-1])
    except ValueError:
        return None


def memory_stats() -> dict[str, float]:
    total_bytes = 0
    proc = run(["sysctl", "-n", "hw.memsize"])
    if proc.returncode == 0:
        try:
            total_bytes = int(proc.stdout.strip())
        except ValueError:
            total_bytes = 0

    page_size = 4096
    pages: dict[str, int] = {}
    vm = run(["vm_stat"])
    if vm.returncode == 0:
        for line in vm.stdout.splitlines():
            m = re.match(r"^\s*([^:]+):\s+([\d.]+)", line)
            if not m:
                continue
            key = m.group(1).strip().replace(" ", "_")
            try:
                pages[key] = int(float(m.group(2)))
            except ValueError:
                continue
        m = re.search(r"page size of (\d+) bytes", vm.stdout)
        if m:
            page_size = int(m.group(1))

    def gb(n: int) -> float:
        return round(n / (1024**3), 2)

    wired = pages.get("Pages_wired_down", 0) * page_size
    active = pages.get("Pages_active", 0) * page_size
    inactive = pages.get("Pages_inactive", 0) * page_size
    compressed = pages.get("Pages_occupied_by_compressor", 0) * page_size
    used = wired + active + compressed
    free = max(0, total_bytes - used - inactive)
    pct = (used / total_bytes * 100.0) if total_bytes else 0.0
    return {
        "total_gb": gb(total_bytes),
        "used_gb": gb(used),
        "free_gb": gb(free),
        "used_pct": round(pct, 1),
    }


def thermal_state() -> str:
    proc = run(["sysctl", "-n", "kern.thermal_level"])
    if proc.returncode != 0:
        return "unknown"
    mapping = {0: "nominal", 1: "fair", 2: "serious", 3: "critical"}
    try:
        return mapping.get(int(proc.stdout.strip()), proc.stdout.strip())
    except ValueError:
        return proc.stdout.strip()


def estimate_temperature(cpu_pct: float | None, state: str) -> tuple[float, str]:
    base = {"nominal": 42.0, "fair": 55.0, "serious": 68.0, "critical": 78.0}.get(state, 45.0)
    usage = cpu_pct if cpu_pct is not None else 0.0
    temp = base + (usage * 0.22)
    return round(min(95.0, max(28.0, temp)), 1), "thermal estimate"


def ioreg_temperatures() -> list[float]:
    proc = run(["ioreg", "-r", "-l"], timeout=12.0)
    if proc.returncode != 0:
        return []
    temps: list[float] = []
    for line in proc.stdout.splitlines():
        if "temperature" not in line.lower() and "temp" not in line.lower():
            continue
        for m in re.finditer(r"=\s*(\d{2,3})\s*$", line.strip()):
            val = int(m.group(1))
            if 20 <= val <= 115:
                temps.append(float(val))
        for m in re.finditer(r'"Temperature"\s*=\s*(\d+)', line):
            val = int(m.group(1))
            if 200 < val < 12000:
                temps.append(val / 100.0)
            elif 20 <= val <= 115:
                temps.append(float(val))
    return temps


def best_temperature(cpu_pct: float | None) -> tuple[float, str]:
    readings = ioreg_temperatures()
    plausible = [t for t in readings if 25 <= t <= 105]
    if plausible:
        return round(sum(plausible) / len(plausible), 1), "ioreg sensors"
    return estimate_temperature(cpu_pct, thermal_state())


def battery_stats() -> dict[str, str | int | float | None]:
    proc = run(["pmset", "-g", "batt"])
    if proc.returncode != 0 or "no battery" in proc.stdout.lower():
        return {"present": False}
    pct = None
    m = re.search(r"(\d+)%", proc.stdout)
    if m:
        pct = int(m.group(1))
    status = "unknown"
    if re.search(r"\bcharging\b", proc.stdout, re.I):
        status = "charging"
    elif re.search(r"\bfull\b", proc.stdout, re.I):
        status = "full"
    elif re.search(r"\bdischarging\b", proc.stdout, re.I):
        status = "discharging"
    elif re.search(r"\bac attached\b", proc.stdout, re.I):
        status = "ac"
    return {"present": True, "percent": pct, "status": status}


def process_footprint_mb() -> float | None:
    proc = run(["pgrep", "-x", "rNitro"])
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    pid = proc.stdout.strip().splitlines()[0]
    ps = run(["ps", "-o", "rss=", "-p", pid])
    if ps.returncode != 0:
        return None
    try:
        rss_kb = int(ps.stdout.strip())
        return round(rss_kb / 1024.0, 1)
    except ValueError:
        return None


def collect_stats() -> dict:
    cpu = cpu_usage_percent()
    temp, temp_src = best_temperature(cpu)
    mem = memory_stats()
    bat = battery_stats()
    app = find_app()
    return {
        "cpu_pct": cpu,
        "temp_c": temp,
        "temp_source": temp_src,
        "thermal": thermal_state(),
        "memory": mem,
        "battery": bat,
        "version": read_version(app),
        "app_path": str(app) if app else None,
        "footprint_mb": process_footprint_mb(),
        "running": process_footprint_mb() is not None,
    }


def format_stats(data: dict, *, json_out: bool = False) -> str:
    if json_out:
        return json.dumps(data, indent=2)

    lines = []
    if data["cpu_pct"] is not None:
        lines.append(f"CPU:      {data['cpu_pct']:.0f}%")
    else:
        lines.append("CPU:      —")
    lines.append(f"Temp:     {data['temp_c']:.0f}°C ({data['temp_source']})")
    lines.append(f"Thermal:  {data['thermal']}")
    mem = data["memory"]
    lines.append(f"RAM:      {mem['used_gb']:.1f}/{mem['total_gb']:.1f} GB ({mem['used_pct']:.0f}%)")
    bat = data["battery"]
    if bat.get("present"):
        pct = bat.get("percent", "?")
        lines.append(f"Battery:  {pct}% ({bat.get('status', 'unknown')})")
    else:
        lines.append("Battery:  N/A")
    lines.append(f"rNitro:   {data['version']}" + (" (running)" if data["running"] else " (not running)"))
    if data["footprint_mb"] is not None:
        lines.append(f"Footprint: {data['footprint_mb']:.1f} MB RSS")
    if data["app_path"]:
        lines.append(f"App:      {data['app_path']}")
    return "\n".join(lines)


def cmd_open(_: argparse.Namespace) -> int:
    app = find_app()
    if app is None:
        print("rNitro.app not found in /Applications or ~/Applications.", file=sys.stderr)
        print("Install: bash install-rNitro.sh", file=sys.stderr)
        return 1
    subprocess.run(["open", "-a", str(app)], check=False)
    return 0


def cmd_quit(_: argparse.Namespace) -> int:
    proc = run(["pgrep", "-x", "rNitro"])
    if proc.returncode != 0 or not proc.stdout.strip():
        print("rNitro is not running.")
        return 0
    subprocess.run(["pkill", "-x", "rNitro"], check=False)
    print("Quit rNitro.")
    return 0


def cmd_stats(args: argparse.Namespace) -> int:
    print(format_stats(collect_stats(), json_out=args.json))
    return 0


def cmd_watch(args: argparse.Namespace) -> int:
    try:
        while True:
            if not args.json:
                print("\033[2J\033[H", end="")
            print(format_stats(collect_stats(), json_out=args.json))
            if args.json:
                print()
            time.sleep(max(0.5, args.interval))
    except KeyboardInterrupt:
        return 0


def cmd_version(_: argparse.Namespace) -> int:
    app = find_app()
    print(read_version(app))
    if app:
        print(app)
    return 0 if app else 1


def cmd_memory(_: argparse.Namespace) -> int:
    mb = process_footprint_mb()
    if mb is None:
        print("rNitro is not running.")
        return 1
    print(f"{mb:.1f} MB RSS")
    return 0


def cmd_path(_: argparse.Namespace) -> int:
    app = find_app()
    if app is None:
        return 1
    print(app)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="rnitro",
        description="rNitro CLI — live system stats and app control",
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("open", help="Open rNitro.app (default)").set_defaults(func=cmd_open, json=False)
    sub.add_parser("quit", help="Quit the menubar app").set_defaults(func=cmd_quit, json=False)
    sub.add_parser("version", help="Print installed app version").set_defaults(func=cmd_version, json=False)
    sub.add_parser("memory", help="RSS of running rNitro process").set_defaults(func=cmd_memory, json=False)
    sub.add_parser("path", help="Print path to rNitro.app").set_defaults(func=cmd_path, json=False)

    stats = sub.add_parser("stats", help="One-shot CPU/RAM/temp/battery snapshot")
    stats.add_argument("--json", action="store_true", help="JSON output")
    stats.set_defaults(func=cmd_stats)

    watch = sub.add_parser("watch", help="Live stats (Ctrl+C to stop)")
    watch.add_argument("-i", "--interval", type=float, default=2.0, help="Refresh seconds (default: 2)")
    watch.add_argument("--json", action="store_true", help="JSON output")
    watch.set_defaults(func=cmd_watch)

    parser.set_defaults(func=cmd_open, command="open", json=False)
    return parser


def main(argv: list[str] | None = None) -> int:
    if sys.platform != "darwin":
        print("rNitro CLI is macOS only.", file=sys.stderr)
        return 1
    parser = build_parser()
    if argv is None:
        argv = sys.argv[1:]
    if not argv:
        return cmd_open(argparse.Namespace(json=False))
    args = parser.parse_args(argv)
    if not hasattr(args, "func"):
        parser.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())