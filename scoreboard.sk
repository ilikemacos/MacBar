# scoreboard.sk
# Skript (https://skriptlang.org) for Minecraft 1.21.4 / Paper-Spigot
# Requires: Skript 2.9+ (or latest release supporting 1.21.4) — vanilla
#           Skript only, no addons. Built entirely on real /scoreboard
#           commands, which Minecraft itself supports out of the box.
#
# IMPORTANT LIMITATION: vanilla Minecraft's sidebar is GLOBAL — every
# online player sees the exact same board, because the /scoreboard
# command's sidebar display slot isn't per-viewer. That's a Minecraft
# protocol limitation, not a Skript one; personalized per-viewer boards
# need a packet-based addon (e.g. SkBee), which you said you don't want.
#
# So this shows one shared board for the whole server:
#   - an animated "SpleenGens" title (cycles color every second)
#   - static lines for the IP and website
#   - a roster line for every online player, showing their name with
#     their rank as a colored prefix (so you'll see your own name/rank
#     listed there along with everyone else's)
#
# Rank comes from the {rank::<player>} variable (defaults to "Member");
# set it elsewhere (e.g. set {rank::%player%} to "Owner") to change it.
#
# /sb toggles the whole board on/off for everyone (op-only), since
# vanilla scoreboards can't be shown/hidden per individual player.

every 1 second:
	if {sb-setup-done} is not set:
		set {_sep} to colored "&7&m----------------"
		set {_ip} to colored "&fIP: &bspleengens.minefort.com"
		set {_web} to colored "&fWeb: &bchopstickshq.com"
		set {_e1} to colored "&1"
		set {_e2} to colored "&2"
		set {_e3} to colored "&3"
		set {_e4} to colored "&4"

		execute console command "scoreboard objectives add spleengens dummy ""SpleenGens"""
		execute console command "scoreboard objectives setdisplay sidebar spleengens"

		execute console command "team add sg_line1"
		execute console command "team add sg_line2"
		execute console command "team add sg_line3"
		execute console command "team add sg_line4"

		execute console command "team join sg_line1 ""%{_e1}%"""
		execute console command "team join sg_line2 ""%{_e2}%"""
		execute console command "team join sg_line3 ""%{_e3}%"""
		execute console command "team join sg_line4 ""%{_e4}%"""

		execute console command "team modify sg_line1 prefix ""%{_sep}%"""
		execute console command "team modify sg_line2 prefix ""%{_ip}%"""
		execute console command "team modify sg_line3 prefix ""%{_web}%"""
		execute console command "team modify sg_line4 prefix ""%{_sep}%"""

		execute console command "scoreboard players set ""%{_e1}%"" spleengens 100"
		execute console command "scoreboard players set ""%{_e2}%"" spleengens 99"
		execute console command "scoreboard players set ""%{_e3}%"" spleengens 98"
		execute console command "scoreboard players set ""%{_e4}%"" spleengens 97"

		set {sb-visible} to true
		set {sb-setup-done} to true

	if {sb-visible} is true:
		add 1 to {sb-color-index}
		if {sb-color-index} > 4:
			set {sb-color-index} to 1
		if {sb-color-index} is 1:
			set {_color} to "&b"
		else if {sb-color-index} is 2:
			set {_color} to "&3"
		else if {sb-color-index} is 3:
			set {_color} to "&9"
		else:
			set {_color} to "&1"
		set {_title} to colored ("%{_color}%&lSpleenGens")
		execute console command "scoreboard objectives modify spleengens displayname ""%{_title}%"""

on join:
	if {rank::%player%} is not set:
		set {rank::%player%} to "Member"
	if {sb-team-id::%player%} is not set:
		add 1 to {sb-team-id-counter}
		set {sb-team-id::%player%} to {sb-team-id-counter}
	set {_team} to "sgp%{sb-team-id::%player%}%"
	set {_prefix} to colored ("&a[%{rank::%player%}%&a] ")
	execute console command "team add %{_team}%"
	execute console command "team modify %{_team}% prefix ""%{_prefix}%"""
	execute console command "team join %{_team}% %player's name%"
	execute console command "scoreboard players set %player's name% spleengens 50"

on quit:
	execute console command "scoreboard players reset %player's name% spleengens"
	if {sb-team-id::%player%} is set:
		execute console command "team remove sgp%{sb-team-id::%player%}%"

command /sb:
	description: Toggle the shared server scoreboard on or off for everyone
	permission: skript.scoreboard.toggle
	permission message: &cYou don't have permission to toggle the scoreboard.
	trigger:
		if {sb-visible} is true:
			execute console command "scoreboard objectives setdisplay sidebar"
			set {sb-visible} to false
			send "&cScoreboard hidden for everyone." to player
		else:
			execute console command "scoreboard objectives setdisplay sidebar spleengens"
			set {sb-visible} to true
			send "&aScoreboard shown for everyone." to player
